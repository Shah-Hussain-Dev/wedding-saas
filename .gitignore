# See https://help.github.com/articles/ignoring-files/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store

# --- Next.js ---
/.next/
/out/
/.swc/
next-env.d.ts

# --- Build / output ---
/build
/dist
*.tsbuildinfo

# --- Environment & secrets ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
credentials.json
secrets.json

# --- Database (local dev) ---
*.db
*.sqlite
*.sqlite3

# --- Prisma generated client ---
/app/generated/

# --- Testing ---
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- Caching / tooling ---
.turbo
.vercel
.cache
.eslintcache
.stylelintcache
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# --- PM2 (local logs if used outside /var/log) ---
logs/
.pm2/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Editors & IDEs ---
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo
*~

# --- Cursor (local agent state; keep rules if you add .cursor/rules) ---
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# --- Agent skills: mirrors from `npx skills add` (canonical copy: .agents/skills/) ---
/agent/
/.claude/
/data/skills/

# --- Local scratch & one-off experiments ---
/scratch/

# --- Misc local artifacts ---
*.local
*.orig
*.bak


.agents/
.agent 