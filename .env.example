# ==============================================================================
# 🌐 1. APPLICATION URLS & BASE CONFIGURATION
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="WedInvites"

# ==============================================================================
# 🗄️ 2. SUPABASE POSTGRESQL DATABASE & PRISMA CONFIGURATION
# ==============================================================================
# DATABASE_URL: Pooled transaction connection string (Port 6543 with pgbouncer)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session connection string for Prisma migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# 🔐 3. NEXTAUTH & AUTHENTICATION SECRETS
# ==============================================================================
# Generate with: openssl rand -base64 32 OR node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="your-development-secret-key-change-in-prod"
NEXTAUTH_URL="http://localhost:3000"

# ==============================================================================
# 🔑 4. GOOGLE OAUTH CREDENTIALS (Google Cloud Console -> Credentials)
# ==============================================================================
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ==============================================================================
# 💳 5. RAZORPAY PAYMENT GATEWAY (Razorpay Dashboard -> API Keys)
# ==============================================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_ID="rzp_test_YourKeyId"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret_from_razorpay_dashboard"

# ==============================================================================
# ☁️ 6. CLOUDINARY MEDIA & AUDIO STORAGE (Cloudinary Dashboard -> API Keys)
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_UPLOAD_PRESET="unfold_wedding_uploads"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# Storage driver: "local" (default in dev) | "cloudinary" (auto in production/Vercel)
AUDIO_STORAGE="local"


# ==============================================================================
# 📧 7. NODEMAILER / SMTP CONFIGURATION (Optional: for Magic Links & Alerts)
# ==============================================================================
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@wedinvites.in"
